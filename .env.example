# ============================================================================
# Environment Variables untuk Deployment Vercel & Supabase Cloud
# Masukkan variabel berikut pada Vercel Dashboard -> Settings -> Environment Variables
# ============================================================================

# 1. URL Proyek Supabase (contoh: https://hqqvbtxfantvoplfcxmt.supabase.co)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# 2. Supabase Anon / Public Key
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# 3. Supabase Service Role Key (Digunakan oleh API Server / Vercel Serverless Function untuk penyimpanan penuh Supabase Storage & Auth)
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# 4. Opsional: Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"
